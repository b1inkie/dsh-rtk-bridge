{
  "name": "dsh-rtk-bridge",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的 rtk 命令改写桥：把 pwsh/bash 命令经 rtk rewrite 改写后执行，让压缩输出直接进入上下文。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rtk",
    "shell",
    "pwsh",
    "rewrite",
    "tokens",
    "context"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b1inkie/dsh-rtk-bridge.git"
  },
  "homepage": "https://github.com/b1inkie/dsh-rtk-bridge#readme",
  "bugs": {
    "url": "https://github.com/b1inkie/dsh-rtk-bridge/issues"
  }
}
